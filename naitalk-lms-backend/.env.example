APP_NAME="NAI TALK LMS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://api.naitalk-lms.test

# The Next.js frontend origin (for CORS) and a shared secret the frontend's
# server-to-server BFF calls must present.
FRONTEND_URL=http://naitalk-lms.test:3000
FRONTEND_INTERNAL_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=naitalk_lms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=uploads
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=naitalk_lms

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@naitalk-lms.test"
MAIL_FROM_NAME="NAI TALK"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Leave blank for real AWS S3; set for S3-compatible providers (DigitalOcean
# Spaces, MinIO, Cloudflare R2, ...).
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Managed payments (NAI TALK collecting on the organization's behalf,
# taking a commission — never exposed to the organization's own admin UI) ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# One-time membership registration fee, charged via the account above and
# split via a pre-configured Paystack Transaction Split code.
PAYSTACK_REGISTRATION_FEE_CENTS=2000000
PAYSTACK_REGISTRATION_SPLIT_CODE=
# Public membership page's pre-account "pay, then register" fee — charged
# via the org's own activated payment config, not the account above.
MEMBERSHIP_FEE_CENTS=2500000
# Used only to auto-fill a course thumbnail when an admin publishes a course
# without uploading one of their own.
PEXELS_API_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
PLATFORM_PAYMENT_PROVIDER=paystack
DEFAULT_MANAGED_COMMISSION_PERCENT=1.0

# Envelope-encryption key for payment credentials at rest.
# Point this at an external KMS-backed value in production.
CREDENTIAL_ENCRYPTION_KEY=

VITE_APP_NAME="${APP_NAME}"
