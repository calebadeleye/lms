# Public origin of this Next.js app used to build absolute links (canonical
# URLs, PWA manifest, OAuth-style redirects). In production this is the
# tenant's own domain — there is no single fixed value across tenants, so
# this is only a local-dev fallback.
NEXT_PUBLIC_APP_URL=http://naitalk-lms.test:3000

# Laravel API origin. Server Components and Route Handlers call this
# directly (server-to-server); it is never exposed to the browser.
BACKEND_SERVER_URL=http://api.naitalk-lms.test

# Shared secret the backend's VerifyFrontendSecret middleware checks before
# trusting the X-Tenant-Hostname override header. Must match
# FRONTEND_INTERNAL_SECRET in the backend's .env.
BACKEND_INTERNAL_SECRET=local-dev-bff-secret-change-me

# 32+ byte random secret used to encrypt the iron-session cookie that holds
# the Laravel bearer token server-side. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Base domain new tenants are provisioned under — must match the backend's
# NEUTRAL_PLATFORM_DOMAIN so the frontend can tell tenant subdomains apart
# from the platform admin host.
NEUTRAL_PLATFORM_DOMAIN=naitalk-lms.test
